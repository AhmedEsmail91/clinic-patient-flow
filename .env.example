# Backend API base URL (exposed to the browser)
NEXT_PUBLIC_API_URL=

# Optional path segment appended to NEXT_PUBLIC_API_URL for serving uploaded images
NEXT_PUBLIC_IMAGE_ROUTE=

# This app's own public URL, used for canonical links, sitemap.xml and robots.txt
NEXT_PUBLIC_SITE_URL=

# Firebase client config (Firestore-backed patient chat) - from Firebase Console > Project settings > General
# See the Backend's Firebase setup docs for how these tie into the chat feature.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
